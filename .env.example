# Production Compose configuration. Copy to .env; never commit .env.
# Generate with openssl rand -hex 32.
JWT_SECRET=
# HTTPS hostname, without protocol, for the optional Caddy deployment.
DOMAIN=incidents.example.com
# Default: no proxy trust. With the bundled Caddy profile use 172.30.50.2/32.
TRUST_PROXY=
# Comma-separated full origins; leave empty for the same-origin frontend.
CORS_ORIGINS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nib Alerts <alerts@example.com>
