# Copy to .env and fill in to enable real email delivery.
# Without these, the app runs fine — notifications are still generated and
# logged to the email_log table, they just aren't actually mailed anywhere.
# See backend/services/email.js.

NODE_ENV=development
# Generate a secret with: openssl rand -hex 32
JWT_SECRET=
# Explicit opt-in for local demo data; forbidden in production.
SEED_DEMO=false
PORT=4000

# --- Email (optional) ---
# If SMTP_HOST is unset, emails are logged (not sent) — safe default for dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BlueB Alerts <alerts@yourdomain.com>"
